# ==============================================================================
# RAVEN VOICE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Gnani AI Vachana Platform Credentials (Mandatory for Live Mode)
# Official Platform: https://api.vachana.ai
# Authentication Header: X-API-Key-ID: <GNANI_API_KEY>
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_TIMBRE_MODEL=timbre-v2.5

# 2. Gnani Evon 30B / Reasoning Endpoint (Optional)
# Open weights: gnani/gnani-evon-v3.3-30B-A3B (Hugging Face)
# Point to your self-hosted vLLM or SGLang OpenAI-compatible server:
EVON_BASE_URL=http://localhost:30000
EVON_API_KEY=
EVON_MODEL_NAME=gnani/gnani-evon-v3.3-30B-A3B

# 3. Security & Storage
SECRET_KEY=raven-intelligence-platform-secret-key-super-secure-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
STORAGE_DIR=./uploads
DATABASE_URL=sqlite:///./raven.db

# 4. Evaluator & Demo Settings
DEMO_MODE_ALLOWED=true
MAX_UPLOAD_SIZE_BYTES=52428800

# 5. Frontend Public URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
